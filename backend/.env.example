NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fall-detection
JWT_SECRET=change_this_to_a_long_random_secret
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# AI servisinin adresi (varsayılan port 8000)
AI_SERVICE_URL=http://localhost:8000
# Redis / Memurai bağlantısı (Windows için Memurai, varsayılan port 6379)
REDIS_URL=redis://localhost:6379


# CANLI THRESHOLDLAR
# Hareketsizlik eşikleri (saniye) — kullanıcı uyku takvimine göre otomatik seçilir
# Test için düşük değerler kullanın (örn. NIGHT=60, DAY=30)
#INACTIVITY_THRESHOLD_NIGHT_SEC=28800   # gece: 8 saat (varsayılan)
#INACTIVITY_THRESHOLD_DAY_SEC=7200      # gündüz: 2 saat (varsayılan)
# PRE_ALARM → CONFIRMED geçiş süresi (saniye) — kullanıcı bu sürede "İyiyim" demezse alarm kesinleşir
#PRE_ALARM_TIMEOUT_SEC=60

# DEMO THREHOLDLAR
INACTIVITY_THRESHOLD_DAY_SEC=15     # (Sadece 15 saniye hareketsizlik)
INACTIVITY_THRESHOLD_NIGHT_SEC=30     # (Gece simülasyonu için 30 saniye)
PRE_ALARM_TIMEOUT_SEC=10            # (İyiyim deme süresi 10 saniye)
